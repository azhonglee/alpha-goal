{
  "schemaVersion": 2,
  "skills": [
    "alpha-goal",
    "executor",
    "verifier"
  ],
  "artifacts": [
    {
      "path": "goal-contract.md",
      "kind": "task",
      "requirement": "required",
      "condition": "all alpha-goal tasks",
      "binding": "Task identity + Contract revision"
    },
    {
      "path": "technical_design.md",
      "kind": "task",
      "requirement": "conditional",
      "condition": "Goal Contract Confirmation Gate selects run technical design",
      "binding": "Task identity + Contract revision + Design revision"
    },
    {
      "path": "checkpoint.md",
      "kind": "task",
      "requirement": "conditional",
      "condition": "all executor runs; update after every important slice and before verifier handoff",
      "binding": "Task identity + Contract revision + applicable Design revision + workspace identity + every in-scope repo manifest/worktree/branch/HEAD/target fingerprint + monotonic slice/verification sequences"
    }
  ],
  "requiredGates": [
    "Entry Gate",
    "Clarification Gate",
    "Review Gate",
    "Confirmation Gate"
  ],
  "claudeAdapter": {
    "path": "references/claude-adapter.md"
  },
  "technicalDesignRunbook": {
    "path": "references/technical-design-runbook.md"
  },
  "checkedFiles": [
    "skills/alpha-goal/SKILL.md",
    "skills/executor/SKILL.md",
    "skills/verifier/SKILL.md",
    "MANIFEST.md",
    "templates/hooks.json",
    "README.md",
    "README.en.md",
    "INSTALL.md",
    "AGENTS.md",
    "tools/verify_strategy_scenarios.js"
  ],
  "strategyScenarioTest": {
    "path": "tools/verify_strategy_scenarios.js"
  }
}
