{
  "schemaVersion": 1,
  "skills": ["alpha-goal", "executor", "verifier"],
  "artifacts": [
    {
      "path": "goal-contract.md",
      "kind": "task",
      "requirement": "required",
      "condition": "all alpha-goal tasks"
    },
    {
      "path": "technical_design.md",
      "kind": "task",
      "requirement": "conditional",
      "condition": "implementation, repair, refactor, hardening, cross-file behavior changes, interface/data-model changes, or material risk"
    },
    {
      "path": "checkpoint.md",
      "kind": "task",
      "requirement": "conditional",
      "condition": "recovery, long-running execution, evidence handoff, or verification handoff"
    },
    {
      "path": "control-state/latest.md",
      "kind": "global",
      "requirement": "conditional",
      "condition": "task identity is ambiguous during recovery"
    }
  ],
  "routes": [
    {
      "name": "NEXT_ITERATION",
      "condition": "same-goal fixable gap"
    },
    {
      "name": "RETURN_TO_ALPHA_GOAL",
      "condition": "scope, authority, or claim-boundary change"
    },
    {
      "name": "BLOCKED",
      "condition": "external blocker"
    },
    {
      "name": "PASS_TO_FINAL",
      "condition": "acceptance evidence satisfied, zero unmet required acceptance items, no unresolved blocker, no authority drift"
    }
  ],
  "gapKinds": [
    "same_goal_fixable",
    "scope_change",
    "authority_change",
    "external_blocker"
  ],
  "evidenceTypes": [
    {
      "name": "from-test",
      "results": ["pass", "fail"]
    },
    {
      "name": "from-build",
      "results": ["pass", "fail"]
    },
    {
      "name": "from-runtime",
      "results": ["observed", "failed"]
    },
    {
      "name": "from-review",
      "results": ["finding", "clear"]
    },
    {
      "name": "from-inspection",
      "results": ["observed"]
    },
    {
      "name": "from-blocker",
      "results": ["blocked"]
    }
  ],
  "requiredGates": ["Entry Gate", "Clarification Gate", "Review Gate", "Confirmation Gate"],
  "clarificationExitRules": [
    "no_confidence_only",
    "no_round_count",
    "no_blocking_gap_handoff"
  ],
  "summaryFields": [
    "Goal",
    "Non-goals",
    "Execution boundary",
    "Key design decisions"
  ],
  "codexGoalSync": {
    "alphaGoalRequiredTerms": [
      "Codex Goal Sync",
      "create_goal",
      "get_goal",
      "Goal Contract Summary",
      "Technical Design link",
      "token_budget",
      "active Codex goal",
      "do not overwrite",
      "do not hand off to `executor`",
      "blocking sync conflict"
    ],
    "executorRequiredTerms": [
      "Codex Goal Boundary",
      "must not create Codex goals",
      "must not call `create_goal`",
      "update_goal",
      "PASS_TO_FINAL",
      "status: complete",
      "status: blocked",
      "at least three consecutive goal turns"
    ]
  },
  "checkedFiles": [
    "skills/alpha-goal/SKILL.md",
    "skills/executor/SKILL.md",
    "skills/verifier/SKILL.md",
    "MANIFEST.md",
    "templates/hooks.json",
    "README.md",
    "README.en.md",
    "INSTALL.md",
    "AGENTS.md"
  ],
  "nodeRequirement": "Node.js 18+"
}
